# ==============================================================================
# HookPulse — Environment Configuration
# ==============================================================================

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Master Security Key & Secret
MASTER_API_KEY=hp_live_master_key_secret_2026
DEFAULT_WEBHOOK_SECRET=whsec_hookpulse_default_hmac_secret_key_32chars

# Retry Policy & Backoff Settings
MAX_RETRY_ATTEMPTS=4
INITIAL_BACKOFF_MS=1000
BACKOFF_MULTIPLIER=2
MAX_BACKOFF_MS=30000
REQUEST_TIMEOUT_MS=5000

# Queue & Storage
STORAGE_BACKEND=memory # memory | sqlite
REDIS_URL=redis://localhost:6379/0
